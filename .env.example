# Base PostgreSQL utilisée par l'API et Airflow.
POSTGRES_PASSWORD=change-me

# Clé JWT commune à l'API et au gateway.
SECRET_KEY=change-me-with-a-long-random-string
JWT_ALGORITHM=HS256

# Comptes de démonstration créés par src/fastapi1/endpoints/dbcrypt.py.
ADMIN_USER_PASSWORD=change-me-admin
DEV_USER_PASSWORD=change-me-dev
CLIENT_USER_PASSWORD=change-me-client

# Compte utilisé par Airflow/gateway pour appeler l'API.
RAKUTEN_API_USER=admin
RAKUTEN_API_PASSWORD_B64=

# Interface Grafana.
GRAFANA_ADMIN_PASSWORD=change-me-grafana
